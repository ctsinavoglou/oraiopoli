---
// Main landing page with flipbook functionality
import Layout from '../layouts/Layout.astro';
import FlipbookCard from '../components/FlipbookCard.astro';
import FlipbookModal from '../components/FlipbookModal.astro';
import fs from 'fs';

function dataUri(path: string): string {
  const abs = new URL(`../../public${path}`, import.meta.url);
  const ext = path.split('.').pop()?.toLowerCase();
  const mimeMap: Record<string, string> = { png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', svg: 'image/svg+xml' };
  const mime = ext && mimeMap[ext] ? mimeMap[ext] : 'application/octet-stream';
  const buf = fs.readFileSync(abs);
  return `data:${mime};base64,${buf.toString('base64')}`;
}

const logoData = dataUri('/logo_transparent.png');
const thumb1 = dataUri('/images/thumbnails/album1.jpg');
const thumb2 = dataUri('/images/thumbnails/album2.jpg');
const thumb3 = dataUri('/images/thumbnails/album3.jpg');

interface Flipbook {
  id: string;
  title: string;
  description: string;
  thumbnail: string; // now data URI
  type: 'images' | 'pdf';
  pages?: string[];
  pdfUrl?: string;
}

const flipbooks: Flipbook[] = [
  {
    id: 'flipbook1',
    title: 'Φρέσκα Προϊόντα',
    description: 'Τα καλύτερα φρέσκα φρούτα και λαχανικά',
    thumbnail: thumb1,
    type: 'pdf',
    pdfUrl: '/pdfs/catalog.pdf'
  },
  {
    id: 'flipbook2',
    title: 'Εβδομαδιαίες Προσφορές',
    description: 'Ανακαλύψτε τις απίστευτες προσφορές μας',
    thumbnail: thumb2,
    type: 'pdf',
    pdfUrl: '/pdfs/catalog.pdf'
  },
  {
    id: 'flipbook3',
    title: 'Κατάλογος Προϊόντων',
    description: 'Όλα τα προϊόντα του σούπερ μάρκετ μας',
    thumbnail: thumb3,
    type: 'pdf',
    pdfUrl: '/pdfs/portfolio.pdf'
  }
];
---

<Layout title="Ωραιόπολη - Σούπερ Μάρκετ">
  <main class="container">
    <header class="hero">
      <div class="logo-container">
        <img src={logoData} alt="Ωραιόπολη Σούπερ Μάρκετ" class="logo" data-inline="true" />
        <h1 class="site-title">Ωραιόπολη</h1>
      </div>
      <p class="tagline">Το Σούπερ Μάρκετ της Γειτονιάς Σας</p>
    </header>

    <section class="flipbooks-grid">
      {flipbooks.map(book => (
        <FlipbookCard
          id={book.id}
          title={book.title}
          description={book.description}
          thumbnail={book.thumbnail}
        />
      ))}
    </section>
  </main>

  <FlipbookModal flipbooks={flipbooks} />
</Layout>

<style>
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
  }

  .hero {
    text-align: center;
    padding: 4rem 2rem 6rem;
    background: white;
    border-radius: 24px;
    margin-bottom: 4rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
    border: 2px solid var(--border);
  }

  .logo-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .logo {
    height: 80px;
    width: auto;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.1));
  }

  .site-title {
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--primary);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .tagline {
    font-size: 1.5rem;
    color: var(--primary);
    margin: 0;
    font-weight: 300;
  }

  .flipbooks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2.5rem;
    margin-bottom: 4rem;
  }

  @media (max-width: 768px) {
    .container {
      padding: 1rem;
    }

    .hero {
      padding: 3rem 1.5rem 4rem;
      margin-bottom: 3rem;
    }

    .logo-container {
      flex-direction: column;
      gap: 1rem;
    }

    .site-title {
      font-size: 2.5rem;
    }

    .tagline {
      font-size: 1.2rem;
    }

    .flipbooks-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
