---
// Main landing page with flipbook functionality
import Layout from '../layouts/Layout.astro';
import FlipbookCard from '../components/FlipbookCard.astro';
import FlipbookModal from '../components/FlipbookModal.astro';

const flipbooks = [
  {
    id: 'flipbook1',
    title: 'Photo Album',
    description: 'Beautiful memories in a digital flipbook',
    thumbnail: '/images/thumbnails/album1.jpg',
    type: 'images',
    pages: [
      '/images/flipbooks/album1/page1.jpg',
      '/images/flipbooks/album1/page2.jpg',
      '/images/flipbooks/album1/page3.jpg',
      '/images/flipbooks/album1/page4.jpg',
    ]
  },
  {
    id: 'flipbook2',
    title: 'Catalog',
    description: 'Explore our latest collection',
    thumbnail: '/images/thumbnails/album2.jpg',
    type: 'pdf',
    pdfUrl: '/pdfs/catalog.pdf'
  },
  {
    id: 'flipbook3',
    title: 'Portfolio',
    description: 'Showcasing our best work',
    thumbnail: '/images/thumbnails/album3.jpg',
    type: 'pdf',
    pdfUrl: '/pdfs/portfolio.pdf'
  }
];
---

<Layout title="Oraiopoli - Digital Flipbooks">
  <main class="container">
    <header class="hero">
      <div class="logo-container">
        <img src="/logo_transparent.png" alt="Oraiopoli Logo" class="logo" />
        <h1 class="site-title">Oraiopoli</h1>
      </div>
      <p class="tagline">Discover Stories, One Page at a Time</p>
    </header>

    <section class="flipbooks-grid">
      {flipbooks.map(book => (
        <FlipbookCard
          id={book.id}
          title={book.title}
          description={book.description}
          thumbnail={book.thumbnail}
        />
      ))}
    </section>
  </main>

  <FlipbookModal flipbooks={flipbooks} />
</Layout>

<style>
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
  }

  .hero {
    text-align: center;
    padding: 4rem 2rem 6rem;
    background: white;
    border-radius: 24px;
    margin-bottom: 4rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
    border: 2px solid var(--border);
  }

  .logo-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .logo {
    height: 80px;
    width: auto;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.1));
  }

  .site-title {
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--primary);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .tagline {
    font-size: 1.5rem;
    color: var(--primary);
    margin: 0;
    font-weight: 300;
  }

  .flipbooks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2.5rem;
    margin-bottom: 4rem;
  }

  @media (max-width: 768px) {
    .container {
      padding: 1rem;
    }

    .hero {
      padding: 3rem 1.5rem 4rem;
      margin-bottom: 3rem;
    }

    .logo-container {
      flex-direction: column;
      gap: 1rem;
    }

    .site-title {
      font-size: 2.5rem;
    }

    .tagline {
      font-size: 1.2rem;
    }

    .flipbooks-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>

