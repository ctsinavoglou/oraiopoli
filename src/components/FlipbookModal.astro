---
// Enhanced Modal component with realistic 3D flipbook viewer using StPageFlip
interface Flipbook {
  id: string;
  title: string;
  type: 'images' | 'pdf';
  pages?: string[];
  pdfUrl?: string;
}

interface Props {
  flipbooks: Flipbook[];
}

const { flipbooks } = Astro.props;
---

<!-- Load StPageFlip library from CDN -->
<script is:inline src="https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.min.js"></script>

<!-- Load PDF.js library from CDN for PDF rendering -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script is:inline>
  // Configure PDF.js worker
  if (typeof pdfjsLib !== 'undefined') {
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
  }
</script>

<div id="flipbook-modal" class="modal" aria-hidden="true">
  <div class="modal-backdrop"></div>
  <div class="modal-container">
    <div class="modal-header">
      <h2 id="modal-title" class="modal-title"></h2>
      <div class="header-controls">
        <button type="button" id="zoom-out" class="icon-btn" aria-label="Σμίκρυνση" title="Σμίκρυνση">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="M21 21l-4.35-4.35M8 11h6"></path>
          </svg>
        </button>
        <span id="zoom-level" class="zoom-level" title="Επίπεδο Μεγέθυνσης">100%</span>
        <button type="button" id="zoom-in" class="icon-btn" aria-label="Μεγέθυνση" title="Μεγέθυνση">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="M21 21l-4.35-4.35M11 8v6M8 11h6"></path>
          </svg>
        </button>
        <button type="button" id="zoom-reset" class="icon-btn" aria-label="Επαναφορά Μεγέθυνσης" title="Επαναφορά Μεγέθυνσης">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="M21 21l-4.35-4.35M11 11h.01"></path>
          </svg>
        </button>
        <button type="button" id="fullscreen-btn" class="icon-btn" aria-label="Πλήρης Οθόνη" title="Πλήρης Οθόνη">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
          </svg>
        </button>
        <button type="button" id="close-modal" class="icon-btn" aria-label="Κλείσιμο">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="flipbook-viewer">
      <div id="flipbook-wrapper" class="flipbook-wrapper">
        <div id="flipbook" class="flipbook">
          <!-- Pages will be inserted here dynamically -->
        </div>
      </div>

      <div class="flipbook-controls">
        <button type="button" id="first-page" class="control-btn secondary" aria-label="Πρώτη Σελίδα" title="Πρώτη Σελίδα">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M11 19l-7-7 7-7m8 14l-7-7 7-7"></path>
          </svg>
        </button>

        <button type="button" id="prev-page" class="control-btn" aria-label="Προηγούμενη Σελίδα">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
          <span>Προηγούμενη</span>
        </button>

        <div class="page-indicator">
          <span id="current-page">0</span> / <span id="total-pages">0</span>
        </div>

        <button type="button" id="next-page" class="control-btn" aria-label="Επόμενη Σελίδα">
          <span>Επόμενη</span>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6"></path>
          </svg>
        </button>

        <button type="button" id="last-page" class="control-btn secondary" aria-label="Τελευταία Σελίδα" title="Τελευταία Σελίδα">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M13 5l7 7-7 7M5 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>

    <div id="loading" class="loading">
      <div class="spinner-ring"></div>
      <p>Φόρτωση...</p>
    </div>
  </div>
</div>

<style>
  .modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .modal.active {
    display: flex;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(8px);
    animation: fadeIn 0.3s ease-out;
  }

  .modal-container {
    position: relative;
    width: 100%;
    height: 100vh;
    background: #1a1a1a;
    display: flex;
    flex-direction: column;
    animation: slideUp 0.4s ease-out;
    overflow: hidden;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(40px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 2rem;
    background: rgba(0, 0, 0, 0.6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
  }

  .modal-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
  }

  .header-controls {
    display: flex;
    gap: 0.5rem;
  }

  .icon-btn {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    cursor: pointer;
    padding: 0.625rem;
    color: white;
    transition: all 0.3s ease;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.3);
    transform: scale(1.05);
  }

  .zoom-level {
    color: white;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0 0.5rem;
    min-width: 50px;
    text-align: center;
  }

  .flipbook-viewer {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
    background: linear-gradient(135deg, #2d2d2d 0%, #1a1a1a 100%);
  }

  .flipbook-wrapper {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    overflow: hidden;
    position: relative;
    cursor: grab;
  }

  .flipbook-wrapper.zoomed {
    cursor: grab;
  }

  .flipbook-wrapper.dragging {
    cursor: grabbing;
  }

  .flipbook {
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
    transform-origin: center center;
    transition: none;
  }

  .flipbook-wrapper.zoomed .flipbook {
    pointer-events: none;
  }

  .flipbook-wrapper.zoomed {
    pointer-events: auto;
  }

  :global(.stf__parent) {
    position: relative !important;
  }

  :global(.stf__wrapper) {
    position: relative !important;
  }

  :global(.stf__item) {
    background-color: white;
    border: 1px solid #e0e0e0;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  :global(.page) {
    width: 100%;
    height: 100%;
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  :global(.page img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  :global(.page-content) {
    width: 100%;
    height: 100%;
    background: white;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem;
    text-align: center;
  }

  .flipbook-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 2rem;
    background: rgba(0, 0, 0, 0.6);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    gap: 1rem;
    backdrop-filter: blur(10px);
  }

  .control-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--primary);
    color: white;
    border: none;
    padding: 0.875rem 1.75rem;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: inherit;
  }

  .control-btn:hover:not(:disabled) {
    background: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 93, 168, 0.4);
  }

  .control-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
  }

  .control-btn.secondary {
    background: rgba(255, 255, 255, 0.1);
    padding: 0.875rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .control-btn.secondary:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.2);
    box-shadow: 0 4px 12px rgba(255, 255, 255, 0.1);
  }

  .page-indicator {
    font-size: 1.125rem;
    font-weight: 600;
    color: white;
    white-space: nowrap;
    padding: 0 1rem;
    min-width: 100px;
    text-align: center;
  }

  .loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    background: #1a1a1a;
    color: white;
    z-index: 10;
  }

  .loading.hidden {
    display: none;
  }

  .spinner-ring {
    width: 60px;
    height: 60px;
    border: 4px solid rgba(255, 255, 255, 0.2);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 768px) {
    .modal-header {
      padding: 1rem 1.5rem;
    }

    .modal-title {
      font-size: 1.125rem;
    }

    .flipbook-wrapper {
      padding: 1rem;
    }

    .flipbook-controls {
      padding: 1rem 1.5rem;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .control-btn {
      padding: 0.75rem 1.25rem;
      font-size: 0.9rem;
    }

    .control-btn span {
      display: none;
    }

    .control-btn.secondary {
      padding: 0.75rem;
    }

    .page-indicator {
      font-size: 1rem;
      min-width: 80px;
      flex: 0 0 auto;
    }
  }
</style>

<script define:vars={{ flipbooks }}>
  class EnhancedFlipbookViewer {
    constructor(flipbooksData) {
      this.flipbooks = flipbooksData;
      this.currentFlipbook = null;
      this.pageFlip = null;
      this.pages = [];
      this.currentScale = 1;
      this.panX = 0;
      this.panY = 0;
      this.isDragging = false;
      this.hasMoved = false;
      this.dragStartX = 0;
      this.dragStartY = 0;
      this.dragStartPanX = 0;
      this.dragStartPanY = 0;
      this.initRetryCount = 0;
      this.maxRetries = 10;
      this.resizeHandler = null;
      this.lastTouchDistance = 0;

      // Cache for loaded flipbook content (images/PDFs)
      this.contentCache = {};

      this.modal = document.getElementById('flipbook-modal');
      this.modalTitle = document.getElementById('modal-title');
      this.flipbookEl = document.getElementById('flipbook');
      this.flipbookWrapper = document.getElementById('flipbook-wrapper');
      this.loading = document.getElementById('loading');
      this.closeBtn = document.getElementById('close-modal');
      this.prevBtn = document.getElementById('prev-page');
      this.nextBtn = document.getElementById('next-page');
      this.firstBtn = document.getElementById('first-page');
      this.lastBtn = document.getElementById('last-page');
      this.zoomInBtn = document.getElementById('zoom-in');
      this.zoomOutBtn = document.getElementById('zoom-out');
      this.zoomResetBtn = document.getElementById('zoom-reset');
      this.zoomLevelEl = document.getElementById('zoom-level');
      this.fullscreenBtn = document.getElementById('fullscreen-btn');
      this.currentPageEl = document.getElementById('current-page');
      this.totalPagesEl = document.getElementById('total-pages');

      this.init();
    }

    init() {
      // Listen for open events
      window.addEventListener('openFlipbook', (e) => {
        console.log('openFlipbook event received:', e.detail);
        this.open(e.detail);
      });

      // Close modal
      this.closeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        this.close();
      });
      this.modal.querySelector('.modal-backdrop').addEventListener('click', (e) => {
        e.preventDefault();
        this.close();
      });

      // Navigation
      this.prevBtn.addEventListener('click', (e) => {
        e.preventDefault();
        this.prevPage();
      });
      this.nextBtn.addEventListener('click', (e) => {
        e.preventDefault();
        this.nextPage();
      });
      this.firstBtn.addEventListener('click', (e) => {
        e.preventDefault();
        this.firstPage();
      });
      this.lastBtn.addEventListener('click', (e) => {
        e.preventDefault();
        this.lastPage();
      });

      // Zoom
      this.zoomInBtn.addEventListener('click', (e) => {
        e.preventDefault();
        this.zoomIn();
      });
      this.zoomOutBtn.addEventListener('click', (e) => {
        e.preventDefault();
        this.zoomOut();
      });
      this.zoomResetBtn.addEventListener('click', (e) => {
        e.preventDefault();
        this.resetZoom();
      });

      // Fullscreen
      this.fullscreenBtn.addEventListener('click', (e) => {
        e.preventDefault();
        this.toggleFullscreen();
      });

      // Keyboard navigation
      document.addEventListener('keydown', (e) => {
        if (!this.modal.classList.contains('active')) return;

        if (e.key === 'Escape') this.close();
        if (e.key === 'ArrowLeft') this.prevPage();
        if (e.key === 'ArrowRight') this.nextPage();
        if (e.key === 'Home') this.firstPage();
        if (e.key === 'End') this.lastPage();
      });

      // Block any navigation attempts when modal is active
      document.addEventListener('click', (e) => {
        if (!this.modal.classList.contains('active')) return;

        // If click is on a link or button inside the modal content, prevent default
        const target = e.target;
        if (target && target.closest && target.closest('.modal-container')) {
          const link = target.closest('a');
          const button = target.closest('button:not([type="button"])');
          if (link || button) {
            e.preventDefault();
            e.stopPropagation();
          }
        }
      }, true);

      // Prevent form submissions when modal is active
      document.addEventListener('submit', (e) => {
        if (this.modal.classList.contains('active')) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);

      // Prevent beforeunload when modal is active
      window.addEventListener('beforeunload', (e) => {
        if (this.modal.classList.contains('active')) {
          e.preventDefault();
          e.stopPropagation();
          return false;
        }
      }, true);

      // Prevent popstate (back/forward navigation)
      window.addEventListener('popstate', (e) => {
        if (this.modal.classList.contains('active')) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);

      // Pan and zoom controls
      this.setupPanAndZoom();
    }

    setupPanAndZoom() {
      const wrapper = this.flipbookWrapper;

      // Mouse wheel zoom
      wrapper.addEventListener('wheel', (e) => {
        if (!this.modal.classList.contains('active')) return;

        e.preventDefault();
        const delta = e.deltaY;
        const factor = delta > 0 ? 0.9 : 1.1;

        // Get mouse position relative to wrapper
        const rect = wrapper.getBoundingClientRect();
        const clientX = e.clientX - rect.left;
        const clientY = e.clientY - rect.top;

        this.zoom(factor, clientX, clientY);
      }, { passive: false });

      // Mouse drag to pan
      wrapper.addEventListener('mousedown', (e) => {
        if (!this.modal.classList.contains('active')) return;
        if (this.currentScale <= 1.01) return; // Only allow dragging when zoomed

        e.preventDefault();
        e.stopPropagation(); // Prevent event from reaching StPageFlip
        this.isDragging = true;
        this.dragStartX = e.clientX;
        this.dragStartY = e.clientY;
        this.dragStartPanX = this.panX;
        this.dragStartPanY = this.panY;
        this.hasMoved = false; // Track if user actually moved the mouse
        wrapper.classList.add('dragging');
      }, true); // Use capture phase to intercept before StPageFlip

      document.addEventListener('mousemove', (e) => {
        if (!this.isDragging) return;

        e.preventDefault();
        e.stopPropagation(); // Prevent event from reaching StPageFlip
        const dx = e.clientX - this.dragStartX;
        const dy = e.clientY - this.dragStartY;

        // Track if there was actual movement
        if (Math.abs(dx) > 2 || Math.abs(dy) > 2) {
          this.hasMoved = true;
        }

        this.panX = this.dragStartPanX + dx;
        this.panY = this.dragStartPanY + dy;

        this.applyTransform(false);
      }, true); // Use capture phase

      document.addEventListener('mouseup', (e) => {
        if (this.isDragging) {
          // Stop propagation if user actually dragged
          if (this.hasMoved) {
            e.preventDefault();
            e.stopPropagation();
          }
          this.isDragging = false;
          this.hasMoved = false;
          wrapper.classList.remove('dragging');
        }
      }, true); // Use capture phase

      // Also prevent clicks on the flipbook when zoomed to avoid accidental page flips
      wrapper.addEventListener('click', (e) => {
        if (this.currentScale > 1.01) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true); // Use capture phase

      // Double-click to zoom in/out
      wrapper.addEventListener('dblclick', (e) => {
        if (!this.modal.classList.contains('active')) return;

        e.preventDefault();
        const rect = wrapper.getBoundingClientRect();
        const clientX = e.clientX - rect.left;
        const clientY = e.clientY - rect.top;

        if (this.currentScale > 1.01) {
          // Zoom out to fit
          this.resetZoom();
        } else {
          // Zoom in
          this.zoom(2, clientX, clientY);
        }
      });

      // Touch support for pinch-to-zoom
      let touchStartDistance = 0;
      let touchStartScale = 1;
      let touchCenter = { x: 0, y: 0 };

      wrapper.addEventListener('touchstart', (e) => {
        if (!this.modal.classList.contains('active')) return;

        if (e.touches.length === 2) {
          e.preventDefault();
          e.stopPropagation();
          const touch1 = e.touches[0];
          const touch2 = e.touches[1];

          touchStartDistance = Math.hypot(
            touch2.clientX - touch1.clientX,
            touch2.clientY - touch1.clientY
          );
          touchStartScale = this.currentScale;

          const rect = wrapper.getBoundingClientRect();
          touchCenter.x = ((touch1.clientX + touch2.clientX) / 2) - rect.left;
          touchCenter.y = ((touch1.clientY + touch2.clientY) / 2) - rect.top;
        } else if (e.touches.length === 1 && this.currentScale > 1.01) {
          // Single touch drag when zoomed
          e.preventDefault();
          e.stopPropagation();
          const touch = e.touches[0];
          this.isDragging = true;
          this.hasMoved = false;
          this.dragStartX = touch.clientX;
          this.dragStartY = touch.clientY;
          this.dragStartPanX = this.panX;
          this.dragStartPanY = this.panY;
        }
      }, { passive: false, capture: true });

      wrapper.addEventListener('touchmove', (e) => {
        if (!this.modal.classList.contains('active')) return;

        if (e.touches.length === 2) {
          e.preventDefault();
          e.stopPropagation();
          const touch1 = e.touches[0];
          const touch2 = e.touches[1];

          const currentDistance = Math.hypot(
            touch2.clientX - touch1.clientX,
            touch2.clientY - touch1.clientY
          );

          const factor = currentDistance / touchStartDistance;
          const newScale = Math.min(Math.max(touchStartScale * factor, 0.5), 4);

          if (newScale !== this.currentScale) {
            this.currentScale = newScale;
            this.applyTransform(false);
            this.updateWrapperState();
          }
        } else if (e.touches.length === 1 && this.isDragging) {
          e.preventDefault();
          e.stopPropagation();
          const touch = e.touches[0];
          const dx = touch.clientX - this.dragStartX;
          const dy = touch.clientY - this.dragStartY;

          // Track if there was actual movement
          if (Math.abs(dx) > 2 || Math.abs(dy) > 2) {
            this.hasMoved = true;
          }

          this.panX = this.dragStartPanX + dx;
          this.panY = this.dragStartPanY + dy;

          this.applyTransform(false);
        }
      }, { passive: false, capture: true });

      wrapper.addEventListener('touchend', (e) => {
        if (this.isDragging && this.hasMoved) {
          e.preventDefault();
          e.stopPropagation();
        }
        this.isDragging = false;
        this.hasMoved = false;
      }, { capture: true });
    }

    resetZoom() {
      this.currentScale = 1;
      this.panX = 0;
      this.panY = 0;
      this.applyTransform(true);
      this.updateWrapperState();
    }

    async open(flipbookId) {
      // Find and load new flipbook
      this.currentFlipbook = this.flipbooks.find(fb => fb.id === flipbookId);
      if (!this.currentFlipbook) return;

      this.modal.classList.add('active');
      this.modal.setAttribute('aria-hidden', 'false');
      this.modalTitle.textContent = this.currentFlipbook.title;
      this.loading.classList.remove('hidden');
      document.body.style.overflow = 'hidden';

      // Fully recreate the root flipbook element
      this.recreateRoot();

      // Reset zoom and pan state
      this.currentScale = 1;
      this.panX = 0;
      this.panY = 0;
      this.isDragging = false;
      this.hasMoved = false;
      this.initRetryCount = 0;

      // Apply the reset transform immediately
      if (this.flipbookEl) {
        this.flipbookEl.style.transform = 'translate(0px, 0px) scale(1)';
        this.flipbookEl.style.transition = 'none';
      }

      // Update zoom level display and wrapper state
      if (this.zoomLevelEl) {
        this.zoomLevelEl.textContent = '100%';
      }
      if (this.flipbookWrapper) {
        this.flipbookWrapper.classList.remove('zoomed');
      }

      try {
        // Check if content is already cached
        if (this.contentCache[flipbookId]) {
          console.log('Loading flipbook from cache:', flipbookId);
          this.pages = this.contentCache[flipbookId];
        } else {
          console.log('Loading flipbook content for the first time:', flipbookId);
          // Load content with timeout
          const loadTimeout = new Promise((_, reject) =>
            setTimeout(() => reject(new Error('Loading timeout')), 30000) // 30 second timeout
          );

          const loadContent = async () => {
            if (this.currentFlipbook.type === 'images') {
              await this.loadImageFlipbook();
            } else if (this.currentFlipbook.type === 'pdf') {
              await this.loadPdfFlipbook();
            }
          };

          await Promise.race([loadContent(), loadTimeout]);

          // Cache the loaded content
          this.contentCache[flipbookId] = this.pages;
          console.log('Cached flipbook content:', flipbookId);
        }

        // Wait for modal animation to complete and DOM to be ready
        await new Promise(resolve => setTimeout(resolve, 500));

        this.initializePageFlip();
        this.loading.classList.add('hidden');

      } catch (error) {
        console.error('Error opening flipbook:', error);
        this.loading.classList.add('hidden');

        // Show error message
        this.flipbookEl.innerHTML = `
          <div style="display: flex; align-items: center; justify-content: center; height: 400px; color: white; text-align: center; padding: 2rem;">
            <div>
              <h2 style="font-size: 2rem; margin-bottom: 1rem;">⚠️ Error Loading Flipbook</h2>
              <p style="font-size: 1.2rem; margin-bottom: 1rem;">${error.message || 'Failed to load content'}</p>
              <button onclick="document.getElementById('close-modal').click()" style="background: var(--primary); color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 8px; font-size: 1rem; cursor: pointer;">
                Close
              </button>
            </div>
          </div>
        `;
      }
    }

    recreateRoot() {
      console.log('Recreating flipbook root element');

      // Destroy existing PageFlip instance
      if (this.pageFlip) {
        try {
          this.pageFlip.destroy();
        } catch (e) {
          console.log('PageFlip destroy error:', e);
        }
        this.pageFlip = null;
      }

      // Remove resize handler
      if (this.resizeHandler) {
        window.removeEventListener('resize', this.resizeHandler);
        this.resizeHandler = null;
      }

      // Find and remove old StPageFlip generated elements
      if (this.flipbookWrapper) {
        const stfParent = this.flipbookWrapper.querySelector('.stf__parent');
        const stfWrapper = this.flipbookWrapper.querySelector('.stf__wrapper');
        if (stfParent) stfParent.remove();
        if (stfWrapper) stfWrapper.remove();
      }

      // Remove old flipbook element
      if (this.flipbookEl) {
        this.flipbookEl.remove();
      }

      // Create new flipbook element
      const newFlipbook = document.createElement('div');
      newFlipbook.id = 'flipbook';
      newFlipbook.className = 'flipbook';

      // Insert into wrapper
      if (this.flipbookWrapper) {
        this.flipbookWrapper.appendChild(newFlipbook);
      }

      // Update reference
      this.flipbookEl = newFlipbook;

      // Clear pages array
      this.pages = [];

      console.log('Flipbook root recreated');
    }

    close() {
      this.modal.classList.remove('active');
      this.modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';

      // Destroy existing flipbook instance
      if (this.pageFlip) {
        try {
          this.pageFlip.destroy();
        } catch (e) {
          console.warn('Error destroying pageFlip:', e);
        }
        this.pageFlip = null;
      }

      // Remove resize handler
      if (this.resizeHandler) {
        window.removeEventListener('resize', this.resizeHandler);
        this.resizeHandler = null;
      }

      // Clear all content and reset state
      this.flipbookEl.innerHTML = '';
      // Don't clear this.pages - keep them cached
      // this.pages = []; // REMOVED - keeping pages in memory for cache
      this.currentFlipbook = null;
      this.initRetryCount = 0;
      this.currentScale = 1;
      this.panX = 0;
      this.panY = 0;
      this.isDragging = false;
      this.hasMoved = false;

      // Reset page indicators
      this.currentPageEl.textContent = '0';
      this.totalPagesEl.textContent = '0';

      // Hide loading spinner
      this.loading.classList.add('hidden');
    }

    async loadImageFlipbook() {
      this.pages = this.currentFlipbook.pages || [];
    }

    async loadPdfFlipbook() {
      const pdfUrl = this.currentFlipbook.pdfUrl;

      try {
        // Load the PDF document
        const loadingTask = pdfjsLib.getDocument(pdfUrl);
        const pdf = await loadingTask.promise;

        // Get all pages
        const numPages = pdf.numPages;
        const pagePromises = [];

        for (let i = 1; i <= numPages; i++) {
          pagePromises.push(this.renderPdfPage(pdf, i));
        }

        // Wait for all pages to render
        this.pages = await Promise.all(pagePromises);

      } catch (error) {
        console.error('Error loading PDF:', error);
        // Fallback to placeholder if PDF fails to load
        this.pages = [{
          type: 'error',
          message: `Failed to load PDF: ${pdfUrl}`,
          error: error.message
        }];
      }
    }

    async renderPdfPage(pdf, pageNum) {
      try {
        const page = await pdf.getPage(pageNum);
        const scale = 2; // Higher scale = better quality
        const viewport = page.getViewport({ scale });

        // Create canvas
        const canvas = document.createElement('canvas');
        const context = canvas.getContext('2d');
        canvas.width = viewport.width;
        canvas.height = viewport.height;

        // Render PDF page to canvas
        const renderContext = {
          canvasContext: context,
          viewport: viewport
        };

        await page.render(renderContext).promise;

        // Convert canvas to data URL
        return {
          type: 'pdf-rendered',
          pageNum: pageNum,
          dataUrl: canvas.toDataURL('image/jpeg', 0.95),
          width: viewport.width,
          height: viewport.height
        };

      } catch (error) {
        console.error(`Error rendering page ${pageNum}:`, error);
        return {
          type: 'pdf-error',
          pageNum: pageNum,
          error: error.message
        };
      }
    }

    initializePageFlip() {
      // Check if we have pages to display
      if (!this.pages || this.pages.length === 0) {
        console.error('No pages to display');
        this.loading.classList.add('hidden');
        this.flipbookEl.innerHTML = `
          <div style="display: flex; align-items: center; justify-content: center; height: 400px; color: white; text-align: center; padding: 2rem;">
            <div>
              <h2 style="font-size: 2rem; margin-bottom: 1rem;">No Content</h2>
              <p style="font-size: 1.2rem;">No pages found to display.</p>
            </div>
          </div>
        `;
        return;
      }

      console.log('Creating pages...', this.pages.length);

      // Preload all images to ensure they're cached
      const imageUrls = this.pages.filter(page => typeof page === 'string');
      if (imageUrls.length > 0) {
        console.log('Preloading images...');
        imageUrls.forEach(url => {
          const preloadImg = new Image();
          preloadImg.src = url;
        });
      }

      // Create pages
      this.pages.forEach((page, index) => {
        const pageDiv = document.createElement('div');
        pageDiv.className = 'page';
        pageDiv.setAttribute('data-density', 'hard');

        if (typeof page === 'string') {
          // Image page - NO lazy loading to prevent reload during flips
          const img = document.createElement('img');
          img.src = page;
          img.alt = `Page ${index + 1}`;
          img.draggable = false;
          img.style.pointerEvents = 'none'; // Prevent any interaction
          pageDiv.appendChild(img);
        } else if (page?.type === 'pdf-rendered') {
          // Actual PDF page rendered as image
          const img = document.createElement('img');
          img.src = page.dataUrl;
          img.alt = `Page ${page.pageNum}`;
          img.draggable = false;
          img.style.pointerEvents = 'none';
          pageDiv.appendChild(img);
        } else if (page?.type === 'pdf-error') {
          // PDF rendering error
          pageDiv.innerHTML = `
            <div class="page-content">
              <h2 style="color: var(--secondary); font-size: 2rem; margin-bottom: 1rem;">⚠️ Error Loading Page ${page.pageNum}</h2>
              <p style="color: #64748b; font-size: 1rem;">
                ${page.error || 'Failed to render PDF page'}
              </p>
            </div>
          `;
        } else if (page?.type === 'error') {
          // PDF loading error
          pageDiv.innerHTML = `
            <div class="page-content">
              <h2 style="color: var(--secondary); font-size: 2rem; margin-bottom: 1rem;">⚠️ Error Loading PDF</h2>
              <p style="color: #64748b; font-size: 1rem; margin-bottom: 1rem;">
                ${page.message || 'Failed to load PDF'}
              </p>
              <p style="color: #94a3b8; font-size: 0.9rem;">
                ${page.error || ''}
              </p>
            </div>
          `;
        }

        this.flipbookEl.appendChild(pageDiv);
      });

      // Force a reflow to ensure DOM is updated
      void this.flipbookEl.offsetHeight;

      // Calculate dimensions with safety checks
      // Use the wrapper instead of parentElement (which can become null)
      const container = this.flipbookWrapper;

      // Check if container exists and is visible
      if (!container) {
        console.error('Container wrapper not found');
        this.loading.classList.add('hidden');
        return;
      }

      // Get computed style to check if element is actually visible
      const computedStyle = window.getComputedStyle(container);
      const isVisible = computedStyle.display !== 'none' &&
                       computedStyle.visibility !== 'hidden' &&
                       computedStyle.opacity !== '0';

      // Check dimensions
      const hasValidDimensions = container.clientWidth > 0 && container.clientHeight > 0;

      console.log('Container check:', {
        exists: !!container,
        visible: isVisible,
        width: container.clientWidth,
        height: container.clientHeight,
        retry: this.initRetryCount
      });

      // Wait for container to be visible and have dimensions
      if (!isVisible || !hasValidDimensions) {
        if (this.initRetryCount < this.maxRetries) {
          this.initRetryCount++;
          console.warn(`Container not ready, retrying... (${this.initRetryCount}/${this.maxRetries})`);
          // Retry after a short delay
          setTimeout(() => this.initializePageFlip(), 200);
          return;
        } else {
          console.error('Failed to initialize flipbook after maximum retries');
          this.loading.classList.add('hidden');
          this.flipbookEl.innerHTML = `
            <div style="display: flex; align-items: center; justify-content: center; height: 400px; color: white; text-align: center; padding: 2rem;">
              <div>
                <h2 style="font-size: 2rem; margin-bottom: 1rem;">⚠️ Initialization Error</h2>
                <p style="font-size: 1.2rem; margin-bottom: 1rem;">Failed to initialize the flipbook viewer. Please try again.</p>
                <button onclick="location.reload()" style="background: var(--primary); color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 8px; font-size: 1rem; cursor: pointer; margin-right: 0.5rem;">
                  Reload Page
                </button>
                <button onclick="document.getElementById('close-modal').click()" style="background: var(--text-secondary); color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 8px; font-size: 1rem; cursor: pointer;">
                  Close
                </button>
              </div>
            </div>
          `;
          return;
        }
      }

      // Reset retry counter on success
      this.initRetryCount = 0;
      console.log('Container ready, initializing flipbook...');

      const containerWidth = container.clientWidth - 100;
      const containerHeight = container.clientHeight - 100;

      // Initialize StPageFlip with responsive sizing
      const width = Math.min(Math.max(containerWidth / 2, 300), 500);
      const height = Math.min(Math.max(containerHeight, 400), 700);

      // Get pages specifically from our flipbook element
      const pageElements = this.flipbookEl.querySelectorAll('.page');

      console.log('Found pages to load:', pageElements.length);

      if (pageElements.length === 0) {
        console.error('No page elements found to initialize flipbook');
        this.loading.classList.add('hidden');
        return;
      }

      this.pageFlip = new St.PageFlip(this.flipbookEl, {
        width: width,
        height: height,
        size: 'stretch',
        minWidth: 300,
        maxWidth: 600,
        minHeight: 400,
        maxHeight: 800,
        drawShadow: true,
        flippingTime: 1000,
        usePortrait: window.innerWidth < 768,
        startZIndex: 0,
        autoSize: true,
        maxShadowOpacity: 0.5,
        showCover: true,
        mobileScrollSupport: true
      });

      console.log('Loading pages into StPageFlip...');

      try {
        this.pageFlip.loadFromHTML(pageElements);
        console.log('Pages loaded successfully');
      } catch (error) {
        console.error('Error loading pages into StPageFlip:', error);
        this.loading.classList.add('hidden');
        throw error;
      }

      // Update page indicator
      this.updatePageIndicator();

      // Listen to page flip events
      this.pageFlip.on('flip', (e) => {
        if (e && e.preventDefault) {
          e.preventDefault();
        }
        if (e && e.stopPropagation) {
          e.stopPropagation();
        }
        this.updatePageIndicator();
      });

      // Handle window resize
      this.resizeHandler = () => {
        if (this.pageFlip) {
          this.pageFlip.updateState();
        }
      };
      window.addEventListener('resize', this.resizeHandler);
    }

    recreateRoot() {
      console.log('Recreating flipbook root element');

      // Destroy existing PageFlip instance
      if (this.pageFlip) {
        try {
          this.pageFlip.destroy();
        } catch (e) {
          console.log('PageFlip destroy error:', e);
        }
        this.pageFlip = null;
      }

      // Remove resize handler
      if (this.resizeHandler) {
        window.removeEventListener('resize', this.resizeHandler);
        this.resizeHandler = null;
      }

      // Find and remove old StPageFlip generated elements
      const wrapper = document.getElementById('flipbook-wrapper');
      if (wrapper) {
        const stfParent = wrapper.querySelector('.stf__parent');
        const stfWrapper = wrapper.querySelector('.stf__wrapper');
        if (stfParent) stfParent.remove();
        if (stfWrapper) stfWrapper.remove();
      }

      // Remove old flipbook element
      if (this.flipbookEl) {
        this.flipbookEl.remove();
      }

      // Create new flipbook element
      const newFlipbook = document.createElement('div');
      newFlipbook.id = 'flipbook';
      newFlipbook.className = 'flipbook';

      // Insert into wrapper
      if (wrapper) {
        wrapper.appendChild(newFlipbook);
      }

      // Update reference
      this.flipbookEl = newFlipbook;

      // Don't clear pages array - keep them cached
      // this.pages = []; // REMOVED - keeping pages in memory for cache

      console.log('Flipbook root recreated');
    }

    updatePageIndicator() {
      if (!this.pageFlip) return;

      const currentPage = this.pageFlip.getCurrentPageIndex() + 1;
      const totalPages = this.pages.length;

      this.currentPageEl.textContent = currentPage;
      this.totalPagesEl.textContent = totalPages;

      // Update button states
      this.prevBtn.disabled = currentPage === 1;
      this.firstBtn.disabled = currentPage === 1;
      this.nextBtn.disabled = currentPage === totalPages;
      this.lastBtn.disabled = currentPage === totalPages;
    }

    nextPage() {
      if (this.pageFlip) {
        this.pageFlip.flipNext();
      }
    }

    prevPage() {
      if (this.pageFlip) {
        this.pageFlip.flipPrev();
      }
    }

    firstPage() {
      if (this.pageFlip) {
        this.pageFlip.flip(0);
      }
    }

    lastPage() {
      if (this.pageFlip) {
        this.pageFlip.flip(this.pages.length - 1);
      }
    }

    zoomIn() {
      // Zoom toward the center of the viewport
      const wrapper = this.flipbookWrapper;
      const rect = wrapper.getBoundingClientRect();
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      this.zoom(1.2, centerX, centerY);
    }

    zoomOut() {
      // Zoom out from the center of the viewport
      const wrapper = this.flipbookWrapper;
      const rect = wrapper.getBoundingClientRect();
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      this.zoom(0.8, centerX, centerY);
    }

    zoom(factor, clientX, clientY) {
      const wrapper = this.flipbookWrapper;
      const flipbook = this.flipbookEl;
      if (!wrapper || !flipbook) return;

      // Calculate new scale
      const newScale = Math.min(Math.max(this.currentScale * factor, 0.5), 4);

      // If we're not actually changing the scale, return
      if (newScale === this.currentScale) return;

      // Get the current transform values
      const rect = flipbook.getBoundingClientRect();
      const wrapperRect = wrapper.getBoundingClientRect();

      // Calculate the point relative to the wrapper
      const pointX = clientX - wrapperRect.left;
      const pointY = clientY - wrapperRect.top;

      // Calculate the point relative to the flipbook (before zoom)
      const flipbookX = (pointX - rect.left + wrapperRect.left) / this.currentScale;
      const flipbookY = (pointY - rect.top + wrapperRect.top) / this.currentScale;

      // Calculate new position to keep the point under the cursor
      const scaleFactor = newScale / this.currentScale;
      const newX = this.panX - (flipbookX * (newScale - this.currentScale));
      const newY = this.panY - (flipbookY * (newScale - this.currentScale));

      this.currentScale = newScale;
      this.panX = newX;
      this.panY = newY;

      this.applyTransform();
      this.updateWrapperState();
    }

    applyTransform(smooth = true) {
      if (this.flipbookEl) {
        this.flipbookEl.style.transition = smooth ? 'transform 0.2s ease-out' : 'none';
        this.flipbookEl.style.transform = `translate(${this.panX}px, ${this.panY}px) scale(${this.currentScale})`;
      }
      this.updateZoomLevel();
    }

    updateWrapperState() {
      if (this.currentScale > 1.01) {
        this.flipbookWrapper.classList.add('zoomed');
      } else {
        this.flipbookWrapper.classList.remove('zoomed');
      }
    }

    updateZoomLevel() {
      if (this.zoomLevelEl) {
        this.zoomLevelEl.textContent = `${Math.round(this.currentScale * 100)}%`;
      }
    }

    toggleFullscreen() {
      if (!document.fullscreenElement) {
        this.modal.requestFullscreen().catch(err => {
          console.log('Fullscreen error:', err);
        });
      } else {
        document.exitFullscreen();
      }
    }
  }

  // Initialize viewer when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      new EnhancedFlipbookViewer(flipbooks);
    });
  } else {
    new EnhancedFlipbookViewer(flipbooks);
  }
</script>

